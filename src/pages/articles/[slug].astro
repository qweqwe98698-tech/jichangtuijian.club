---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import FAQ from '../../components/FAQ.astro';
import NextStep from '../../components/NextStep.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id.replace(/\.(md|mdx)$/, '') },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { data } = article;

// Format dates
const formattedPubDate = data.pubDate;
const formattedUpdatedDate = data.updatedDate || data.pubDate;

// Generate Schema for GEO & Search Engines
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: data.title,
  description: data.description,
  datePublished: formattedPubDate,
  dateModified: formattedUpdatedDate,
  author: {
    '@type': 'Organization',
    name: data.author || '机场推荐 Club 评测组',
    url: 'https://jichangtuijian.club/about/',
  },
  publisher: {
    '@type': 'Organization',
    name: '机场推荐 Club',
    url: 'https://jichangtuijian.club/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://jichangtuijian.club/favicon.svg',
    },
  },
  keywords: [data.primaryKeyword, ...(data.secondaryKeywords || []), ...(data.tags || [])].join(', '),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://jichangtuijian.club/articles/${Astro.params.slug}/`,
  },
};
---

<BaseLayout
  title={`${data.title} | 机场推荐 Club`}
  description={data.description}
  canonicalUrl={`https://jichangtuijian.club/articles/${Astro.params.slug}/`}
  type="article"
  pubDate={formattedPubDate}
  updatedDate={formattedUpdatedDate}
  schema={articleSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumb
      items={[
        { title: '技术专栏与专题矩阵', url: '/articles/' },
        { title: data.title },
      ]}
    />

    <header class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-widest px-2.5 py-1 rounded-md bg-cyan-500/10 border border-cyan-500/20">
          {data.category || '深度专栏'}
        </span>
        <span class="text-xs text-slate-400">
          {data.tags?.map((t) => `#${t}`).join(' ')}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
        {data.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 mt-4 text-xs text-slate-400 border-b border-white/5 pb-4">
        <span>作者：{data.author || '机场推荐 Club 评测组'}</span>
        <span>•</span>
        <span>发布时间：{formattedPubDate}</span>
        <span>•</span>
        <span>最后更新：{formattedUpdatedDate}</span>
        <span>•</span>
        <span class="text-emerald-400">GEO 深度实测认证</span>
      </div>
    </header>

    {data.quickAnswer && (
      <QuickAnswer
        answerType={data.answerType || 'decision'}
        summary={data.quickAnswer}
        points={[
          `核心定位：${data.primaryKeyword} 深度技术剖析`,
          `评测依据：实验室真实网络环境实测与 SLA 证据链验证`,
          `建议策略：${data.nextStep || '查看 2026 稳定机场推荐与测速横评'}`,
        ]}
      />
    )}

    <!-- Main Markdown Article Body -->
    <article class="prose-atlas my-10 space-y-6">
      <Content />
    </article>

    <!-- NextStep Navigation -->
    <NextStep
      level={data.commercialLevel || 'level2'}
      title={data.nextStep || '查看 2026 稳定机场推荐与测速横评'}
      description="基于全天候 SLA 监控与真实 FTTH 物理环境实测，杜绝虚假测速与跑路风险。"
      primaryLink={{ text: '查看 2026 稳定机场推荐', url: '/stable-airport/' }}
      secondaryLink={{ text: '查看 2026 综合排行榜', url: '/airport-ranking/' }}
    />
  </div>
</BaseLayout>
