---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import NextStep from '../../components/NextStep.astro';

const topics = [
  {
    title: 'VLESS vs VMess vs Trojan 深度技术对决：2026 代理协议选型指南',
    slug: '/knowledge/vless-vs-vmess/',
    category: '前沿协议',
    summary: '深度对比 VLESS、VMess、Trojan 与 Shadowsocks 2022。解析无状态轻量架构、零二次加密与抗封锁性能。',
  },
  {
    title: 'TUIC v5 与 Hysteria 2 UDP 暴力协议实测：恶劣公网下的 4K 播放',
    slug: '/knowledge/tuic-vs-hysteria2/',
    category: 'QUIC/UDP加速',
    summary: '基于 RFC 9000 QUIC 的 Brutal 拥塞控制、端口跳跃抗 QoS 机制与 20% 丢包网络下的极限下行实测。',
  },
  {
    title: 'Reality 真实 TLS 伪装机制深度解析：终结自建域名与 SNI 阻断',
    slug: '/knowledge/reality/',
    category: '抗封锁伪装',
    summary: '揭秘 Reality 如何借用苹果/微软大厂真实合法证书，Fallback 透明反向代理机制彻底消除探测特征。',
  },
  {
    title: 'Mihomo (Clash Meta) 与 sing-box 核心深度对比与选型指南',
    slug: '/knowledge/mihomo-vs-singbox/',
    category: '代理内核',
    summary: '后 Clash 时代两大主力内核对决：内存占用开销（22MB vs 80MB）、YAML 与 JSON 规则语法哲学。',
  },
  {
    title: '专线机场成本透明化账本：算清物理成本，为什么 99 元年付必死？',
    slug: '/knowledge/transit-costs/',
    category: '网络经济学',
    summary: '公开深圳 BGP 入口与深港 IEPL 海缆真实批发报价（超 2 万元/Gbps/月），超卖数学模型推演崩盘内幕。',
  },
  {
    title: '在线订阅转换安全陷阱与隐私防范：本地离线与 Docker 自建 SOP',
    slug: '/knowledge/subconverter-security/',
    category: '隐私安全',
    summary: '揭秘恶意转换后台偷跑节点流量黑幕，提供纯本地 WebAssembly 转换与 Docker 私有化部署指令。',
  },
  {
    title: 'IEPL 专线是什么意思？技术架构与真假专线辨析',
    slug: '/knowledge/iepl/',
    category: '线路拓扑',
    summary: '国际以太网专线（IEPL）物理层原理，为什么它能彻底绕过 GFW 防火墙审查？',
  },
  {
    title: 'IPLC 专线是什么？与 IEPL 的核心区别',
    slug: '/knowledge/iplc/',
    category: '线路拓扑',
    summary: '传统国际私有租用物理线路详解，电信级硬隔离与金融级低延迟特性分析。',
  },
  {
    title: '原生 IP、广播 IP 与住宅 IP 区别全解析',
    slug: '/knowledge/native-ip/',
    category: 'IP 与风控',
    summary: '搞懂为什么你的节点会被 Netflix、ChatGPT 和 Claude 识别为代理，原生 IP 的判断标准与测试方法。',
  },
  {
    title: '机场是什么？科学上网为什么叫机场？',
    slug: '/knowledge/what-is-airport/',
    category: '小白基础',
    summary: '通俗易懂解释科学上网代理服务的本质原理、Shadowsocks 飞机图标起源与节点工作方式。',
  },
  {
    title: '机场和传统 VPN 有什么区别？原理与优劣势横评',
    slug: '/knowledge/airport-vs-vpn/',
    category: '核心概念',
    summary: '为什么 ExpressVPN / NordVPN 在大陆频频失效，而专线机场却能稳如泰山？协议与特征码深度对比。',
  },
  {
    title: '公网中转与普通直连有什么区别？为什么晚高峰会卡',
    slug: '/knowledge/transit-vs-direct/',
    category: '线路拓扑',
    summary: '解构 BGP 国内入口中转服务器工作机制，为什么直连线路在晚高峰会遭遇严重 QOS 丢包。',
  },
  {
    title: 'Hysteria2 协议技术解析：基于 QUIC 的暴力抗丢包神器',
    slug: '/knowledge/hysteria2/',
    category: '新一代协议',
    summary: '下一代 UDP 加速协议原理，在恶劣网络与高丢包环境下如何跑满千兆带宽。',
  },
];
---

<BaseLayout
  title="代理技术百科与网络知识库：专线线路、协议与原生IP全景解析"
  description="2026 科学上网与代理技术百科。涵盖 IEPL/IPLC 专线原理、机场与 VPN 区别、原生 IP 鉴别、Hysteria2 协议以及流媒体解锁底层技术。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumb items={[{ title: '技术知识库' }]} />

    <div class="max-w-3xl mb-8">
      <span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-widest block mb-2">TECHNICAL ENCYCLOPEDIA</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        代理技术与网络基础知识百科
      </h1>
      <p class="text-slate-300 text-sm sm:text-base mt-2">
        拒绝生涩难懂的学术黑话。用生动清晰的工程语言，拆解专线光缆、加密协议与网络风控底层逻辑。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-10">
      {topics.map((t) => (
        <div class="glass-card p-6 flex flex-col justify-between group">
          <div>
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 inline-block mb-3">
              {t.category}
            </span>
            <h2 class="text-base font-bold text-white group-hover:text-cyan-400 transition-colors mb-2">
              <a href={t.slug}>{t.title}</a>
            </h2>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">{t.summary}</p>
          </div>

          <a
            href={t.slug}
            class="text-xs font-semibold text-cyan-400 hover:text-cyan-300 flex items-center gap-1.5 pt-4 border-t border-white/5"
          >
            <span>阅读技术解析</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      ))}
    </div>

    <NextStep
      level="level2"
      title="了解原理后，想挑选一条真正的 IEPL 专线？"
      description="查看我们基于真实 SLA 压测的 2026 稳定专线机场榜单。"
      primaryLink={{ text: '查看 2026 稳定机场排行榜', url: '/airport-ranking/' }}
      secondaryLink={{ text: '查看 IEPL 专线深度横评', url: '/iepl-airport/' }}
    />
  </div>
</BaseLayout>
