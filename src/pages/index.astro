---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProviderCard from '../components/ProviderCard.astro';
import FAQ from '../components/FAQ.astro';
import NextStep from '../components/NextStep.astro';
import Wizard from '../components/Wizard.astro';
import LatencyProbe from '../components/LatencyProbe.astro';
import { getAllProviders, getFeaturedProviders } from '../lib/providers';

const providers = getFeaturedProviders();

// 首页核心 FAQ
const homeFaqs = [
  {
    question: '2026年翻墙机场该怎么挑选才能避免踩坑？',
    answer: '核心掌握三条法则：第一，永远首选支持“按月付费”的机场，拒绝动辄三五年的超长年付诱惑；第二，优先选择采用 IEPL/IPLC 纯内网专线的服务商，晚高峰抗波动与抗封锁能力远超公网中转；第三，关注节点 IP 是否为原生纯净 IP，以确保 ChatGPT、Claude 和 Netflix 能够顺畅解锁。',
  },
  {
    question: '稳定机场的核心评估指标有哪些？',
    answer: '衡量稳定性的关键指标包括：晚高峰 20:00-23:00 的网络丢包率（应 < 0.1%）、节点抖动（Jitter < 5ms）、服务商的 SLA 可用性承诺（≥ 99.9%）、以及是否拥有多入口 BGP 智能容灾与双活专线备份。',
  },
  {
    question: '便宜机场和高端专线机场有什么本质区别？',
    answer: '便宜机场多采用公网单线中转或直连，租用低成本服务器，晚高峰极易遭遇运营商 QOS 限速和 GFW 敏感期大面积断连；高端专线机场采用企业级 IEPL/IPLC 内网光纤，数据不过公网防火墙，延迟固定且几乎 0 丢包，成本相应较高。',
  },
  {
    question: '小白新手第一次购买机场需要注意什么？',
    answer: '首先根据自己的设备选择客户端（如 Windows 选 Clash Verge，iOS 准备美区 Apple ID 下载 Shadowrocket）；其次先购买最低档月付套餐进行 1-3 天真实体验；最后切勿在公共网络或不可信网页暴露自己的订阅链接。',
  },
  {
    question: 'Clash、Shadowrocket、v2rayN 与 sing-box 该如何选择？',
    answer: '苹果 iOS 手机首选 Shadowrocket（小火箭，操作直观）；Windows/Mac 电脑推荐 Clash Verge Rev（界面现代、规则分流强大）；安卓手机推荐 Clash Meta 或 v2rayNG；追求极低内存占用与新协议特性的极客可选用 sing-box。',
  },
  {
    question: 'ChatGPT 和 Claude 重度用户选机场有什么特殊要求？',
    answer: 'OpenAI 与 Anthropic 对代理 IP 的风控极为严苛。需选择具备“原生家庭宽带 IP”或“机房纯净商业 IP”并做了分流伪装的机场节点，避免由于万人共用劣质广播 IP 而频繁遭遇 1020 报错或封号。',
  },
  {
    question: '如何识别一家机场是否存在“跑路”风险？',
    answer: '典型前兆包括：突发 3 折/5 折终身大促销、官方 Telegram 群全员禁言、工单超过 48 小时无人应答、节点大面积超时超一周无维护公告等。',
  },
];
---

<BaseLayout
  title="2026 机场推荐与选型指南：稳定专线、真实 SLA 与防坑数据库 | 机场推荐 Club"
  description="机场推荐 Club 是专注于网络代理知识、稳定 IEPL 专线机场选型、客户端教程与故障排查的权威中文数据库。拒绝虚假测速营销，为您提供真实中立的节点选型决策指南。"
>
  <!-- SECTION 01: HERO ATLAS (SCHEME A: 冷峻极客工程台) -->
  <section class="relative pt-10 pb-18 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Left Hero Content -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Live Radar Status Pill -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-cyan-500/30 shadow-lg shadow-cyan-500/5 backdrop-blur-md">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="text-[11px] font-mono font-semibold tracking-wider text-slate-200 uppercase">
            LIVE RADAR <span class="text-slate-600">//</span> 2026.08 晚高峰 SLA 实时监测中
          </span>
        </div>

        <!-- High-Contrast Ultra-Clean Heading (No tacky rainbow gradients) -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-[-0.035em] text-white leading-[1.12]">
          2026 科学出海决策中心<br />
          <span class="text-slate-100 relative inline-block mt-1">
            专线机场选型与真实 SLA 数据库
            <span class="absolute left-0 -bottom-1.5 w-full h-[2px] bg-gradient-to-r from-cyan-400 via-sky-400 to-transparent"></span>
          </span>
        </h1>

        <!-- Balanced Subtitle (No orphan words) -->
        <p class="text-sm sm:text-base text-slate-300 max-w-2xl leading-relaxed font-normal">
          终结单线程测速谎言与年付跑路陷阱。整合全网 50+ 品牌晚高峰抗波动实测与 Claude/ChatGPT 原生 IP 纯净度检测，为您输出不卡顿的专线选型方案与全平台配置 SOP。
        </p>

        <!-- 4-Column Micro-Telemetry Badges -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-1">
          <div class="p-2.5 rounded-xl bg-slate-900/80 border border-white/10 flex flex-col">
            <span class="text-[10px] text-slate-400 font-mono">深港 IEPL 骨干</span>
            <span class="text-xs font-bold text-cyan-400 font-mono mt-0.5">12ms · 0丢包</span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-900/80 border border-white/10 flex flex-col">
            <span class="text-[10px] text-slate-400 font-mono">晚高峰波动率</span>
            <span class="text-xs font-bold text-emerald-400 font-mono mt-0.5">&lt; 0.01%</span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-900/80 border border-white/10 flex flex-col">
            <span class="text-[10px] text-slate-400 font-mono">AI 原生家宽</span>
            <span class="text-xs font-bold text-sky-300 font-mono mt-0.5">100% 纯净度</span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-900/80 border border-white/10 flex flex-col">
            <span class="text-[10px] text-slate-400 font-mono">综合可用性</span>
            <span class="text-xs font-bold text-emerald-400 font-mono mt-0.5">99.98% SLA</span>
          </div>
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-3.5 pt-2">
          <a
            href="/airport-ranking/"
            class="px-6 py-3 rounded-xl bg-gradient-to-r from-cyan-500 via-sky-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-semibold text-xs sm:text-sm shadow-lg shadow-cyan-500/25 transition-all flex items-center gap-2"
          >
            <span>探索 2026 天梯数据库</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a
            href="#beginner-journey"
            class="px-5 py-3 rounded-xl bg-slate-900/90 hover:bg-slate-800 border border-white/10 text-slate-300 hover:text-white font-medium text-xs sm:text-sm transition-all"
          >
            新手从零开始
          </a>
          <a
            href="/methodology/"
            class="px-4 py-3 rounded-xl text-slate-400 hover:text-cyan-400 font-medium text-xs sm:text-sm transition-colors flex items-center gap-1"
          >
            <span>评测方法论</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <!-- Large Search Bar (SECTION 01 SEARCH) -->
        <div id="search-section" class="pt-4">
          <div class="relative max-w-xl">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <input
              type="text"
              id="global-search-input"
              placeholder="你遇到了什么问题？搜品牌、客户端报错、ChatGPT 节点..."
              class="w-full pl-11 pr-24 py-3.5 rounded-xl bg-slate-900/90 border border-white/15 text-sm text-white placeholder-slate-400 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all shadow-inner"
            />
            <button
              onclick="alert('正在为您检索知识库...');"
              class="absolute right-2 top-2 px-4 py-1.5 rounded-lg bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-300 text-xs font-medium transition-colors"
            >
              搜索
            </button>
          </div>
          <!-- Quick Search Tags -->
          <div class="flex flex-wrap items-center gap-2 mt-3 text-xs text-slate-400">
            <span>热门检索：</span>
            <a href="/troubleshooting/timeout/" class="hover:text-cyan-400 transition-colors">节点全红TIMEOUT</a>
            <span class="text-slate-600">•</span>
            <a href="/chatgpt-airport/" class="hover:text-cyan-400 transition-colors">ChatGPT 4o 专线</a>
            <span class="text-slate-600">•</span>
            <a href="/dedicated-line-airport/" class="hover:text-cyan-400 transition-colors">IEPL 与 IPLC</a>
            <span class="text-slate-600">•</span>
            <a href="/cheap-airport/" class="hover:text-cyan-400 transition-colors">10元平价月付</a>
          </div>
        </div>
      </div>

      <!-- Right Abstract Signal Radar Panel (Fully Dynamic Telemetry Observatory Console) -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl bg-slate-900/95 border border-cyan-500/40 shadow-[0_0_60px_-12px_rgba(6,182,212,0.35)] relative overflow-hidden backdrop-blur-2xl">
          <!-- Scanning Laser Sweep Effect -->
          <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
            <div class="w-full h-28 bg-gradient-to-b from-transparent via-cyan-400/10 to-transparent -translate-y-full animate-[scan_5s_ease-in-out_infinite]"></div>
          </div>

          <!-- Console Top Window Header -->
          <div class="px-5 py-3.5 bg-slate-950/90 border-b border-white/10 flex items-center justify-between relative z-10">
            <div class="flex items-center gap-3">
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500/90 shadow-[0_0_6px_rgba(244,63,94,0.6)]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500/90 shadow-[0_0_6px_rgba(245,158,11,0.6)]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/90 shadow-[0_0_6px_rgba(16,185,129,0.6)]"></span>
              </div>
              <div class="h-3 w-px bg-white/10"></div>
              <div class="flex items-center gap-2">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <span class="text-[11px] font-mono font-bold tracking-wider text-slate-200 uppercase">SIGNAL ATLAS v2.6</span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-mono text-cyan-400 bg-cyan-950/90 px-2 py-0.5 rounded border border-cyan-500/40 font-semibold" id="console-live-clock">
                --:--:-- CST
              </span>
              <span class="text-[10px] font-mono text-emerald-400 bg-emerald-950/90 px-1.5 py-0.5 rounded border border-emerald-500/40 animate-pulse flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>LIVE</span>
              </span>
            </div>
          </div>

          <!-- Interactive Mode Tabs & Packet Stream -->
          <div class="px-5 pt-3 pb-2 bg-slate-950/50 border-b border-white/5 flex items-center justify-between text-[11px] font-mono relative z-10">
            <div class="flex items-center gap-1.5">
              <button id="tab-telemetry" class="px-2.5 py-1 rounded-md bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-semibold transition-all shadow-[0_0_10px_rgba(6,182,212,0.25)]">
                ⚡ 链路遥测
              </button>
              <button id="tab-topology" class="px-2.5 py-1 rounded-md bg-slate-900/60 text-slate-400 hover:text-slate-200 border border-white/5 transition-all">
                🗺️ BGP 拓扑
              </button>
              <button id="tab-security" class="px-2.5 py-1 rounded-md bg-slate-900/60 text-slate-400 hover:text-slate-200 border border-white/5 transition-all">
                🛡️ 纯净矩阵
              </button>
            </div>
            <span class="text-[10px] text-cyan-400 font-bold bg-slate-950 px-2 py-0.5 rounded border border-white/5" id="live-packet-counter">
              PKTS: 24,891
            </span>
          </div>

          <!-- Real-Time Waveform Oscilloscope Panel -->
          <div class="px-5 pt-3 pb-2 bg-slate-950/70 border-b border-white/5 relative z-10">
            <div class="flex items-center justify-between text-[10px] font-mono mb-1.5">
              <span class="flex items-center gap-1.5 text-slate-300">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse shadow-[0_0_6px_rgba(6,182,212,0.8)]"></span>
                <span>深港 IEPL 实时心跳采样</span>
              </span>
              <span class="text-cyan-400 font-bold font-mono" id="live-jitter-display">Jitter: 0.8ms · 0.00% Loss</span>
            </div>
            <!-- Canvas Oscilloscope with Fallback Grid Background -->
            <div class="h-14 w-full relative rounded-lg bg-slate-950 border border-cyan-500/30 overflow-hidden shadow-inner flex items-center justify-center">
              <canvas id="oscilloscope-canvas" class="w-full h-full block relative z-10"></canvas>
              <!-- Live Scanning Center Dot Overlay -->
              <div class="absolute right-2 top-2 z-20 flex items-center gap-1 text-[9px] font-mono text-emerald-400 bg-emerald-950/80 px-1.5 py-0.5 rounded border border-emerald-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                <span id="live-hz-indicator">60 FPS</span>
              </div>
            </div>
          </div>

          <!-- Console Body Metrics -->
          <div class="p-5 space-y-3 font-mono relative z-10" id="view-telemetry">
            <!-- Dynamic Active Probe Rotator Banner -->
            <div class="grid grid-cols-2 gap-2.5 mb-1">
              <div class="p-2.5 rounded-xl bg-slate-950/80 border border-cyan-500/20 flex flex-col justify-between">
                <div class="text-[10px] text-slate-400 uppercase flex items-center justify-between">
                  <span>BGP PROBE ROTATOR</span>
                  <span class="text-emerald-400 font-bold animate-pulse">● 轮巡</span>
                </div>
                <div class="text-xs font-bold text-white flex items-center gap-1.5 mt-1 truncate">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
                  <span class="text-cyan-300 truncate" id="live-probe-rotator">光速云 #1 (12.4ms OK)</span>
                </div>
              </div>
              <div class="p-2.5 rounded-xl bg-slate-950/80 border border-white/5 flex flex-col justify-between">
                <div class="text-[10px] text-slate-400 uppercase flex items-center justify-between">
                  <span>REALTIME I/O TRAFFIC</span>
                  <span class="text-cyan-400 font-bold" id="live-loss-stat">0.00% 丢包</span>
                </div>
                <div class="text-[11px] font-bold text-emerald-400 mt-1 flex items-center justify-between">
                  <span id="live-io-traffic">Tx: 14.8M · Rx: 98.2M</span>
                </div>
              </div>
            </div>

            <!-- Telemetry Row 1: 深港 IEPL 骨干专线 -->
            <div class="p-3 rounded-xl bg-slate-950/90 border border-white/5 hover:border-cyan-500/50 hover:bg-slate-900 transition-all group cursor-pointer shadow-sm">
              <div class="flex items-center justify-between mb-1.5">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_10px_rgba(6,182,212,0.9)] animate-pulse"></span>
                  <span class="text-xs font-bold text-slate-200 group-hover:text-cyan-300 transition-colors">深港 IEPL 骨干专线</span>
                  <span class="text-[9px] px-1.5 py-0.5 rounded bg-cyan-950 text-cyan-400 border border-cyan-800/40">VLESS / SS</span>
                </div>
                <div class="text-right flex items-center gap-1.5">
                  <span class="text-xs font-extrabold text-emerald-400 font-mono px-1.5 py-0.5 rounded bg-emerald-950/60 border border-emerald-500/30" id="live-latency-sz">12.4 ms</span>
                  <span class="text-[10px] text-slate-400">· 0% 丢包</span>
                </div>
              </div>
              <div class="flex items-center justify-between text-[10px] text-slate-400 pt-1 border-t border-white/5">
                <span class="flex items-center gap-1">
                  <span>深圳电信 BGP ═══▶ 香港 Equinix</span>
                </span>
                <span class="text-slate-400">Jitter: <strong class="text-cyan-400 font-mono" id="live-jitter-sz">0.8ms</strong></span>
              </div>
            </div>

            <!-- Telemetry Row 2: 沪日 IPLC 极速专线 -->
            <div class="p-3 rounded-xl bg-slate-950/90 border border-white/5 hover:border-emerald-500/50 hover:bg-slate-900 transition-all group cursor-pointer shadow-sm">
              <div class="flex items-center justify-between mb-1.5">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.9)] animate-pulse"></span>
                  <span class="text-xs font-bold text-slate-200 group-hover:text-emerald-300 transition-colors">沪日 IPLC 极速专线</span>
                  <span class="text-[9px] px-1.5 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800/40">物理光缆</span>
                </div>
                <div class="text-right flex items-center gap-1.5">
                  <span class="text-xs font-extrabold text-emerald-400 font-mono px-1.5 py-0.5 rounded bg-emerald-950/60 border border-emerald-500/30" id="live-latency-sh">28.2 ms</span>
                  <span class="text-[10px] text-slate-400">· 0% 丢包</span>
                </div>
              </div>
              <div class="flex items-center justify-between text-[10px] text-slate-400 pt-1 border-t border-white/5">
                <span>上海联通 ═══▶ 东京 NTT 直通</span>
                <span class="text-slate-400">Jitter: <strong class="text-emerald-400 font-mono" id="live-jitter-sh">1.1ms</strong></span>
              </div>
            </div>

            <!-- Telemetry Row 3: AI 原生住宅 IP 纯净度 -->
            <div class="p-3 rounded-xl bg-slate-950/90 border border-white/5 hover:border-sky-500/50 hover:bg-slate-900 transition-all group cursor-pointer shadow-sm">
              <div class="flex items-center justify-between mb-1.5">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-sky-400 shadow-[0_0_10px_rgba(56,189,248,0.9)]"></span>
                  <span class="text-xs font-bold text-slate-200 group-hover:text-sky-300 transition-colors">AI 原生 IP 纯净度</span>
                  <span class="text-[9px] px-1.5 py-0.5 rounded bg-sky-950 text-sky-400 border border-sky-800/40">AT&T / ISP</span>
                </div>
                <div class="text-right flex items-center gap-1.5">
                  <span class="text-xs font-extrabold text-cyan-400 font-mono px-1.5 py-0.5 rounded bg-cyan-950/60 border border-cyan-500/30" id="live-fraud-score">99 / 100</span>
                  <span class="text-[10px] text-emerald-400 font-bold">极低风控</span>
                </div>
              </div>
              <div class="flex items-center justify-between text-[10px] text-slate-400 pt-1 border-t border-white/5">
                <span>OpenAI / Claude 3.7 直连</span>
                <span class="text-slate-400">5秒盾拦截: <strong class="text-emerald-400 font-mono" id="live-shield-rate">0.0%</strong></span>
              </div>
            </div>

            <!-- Telemetry Row 4: 4K 流媒体秒开率与实时下行吞吐 -->
            <div class="p-3 rounded-xl bg-slate-950/90 border border-white/5 hover:border-emerald-500/50 hover:bg-slate-900 transition-all group cursor-pointer shadow-sm">
              <div class="flex items-center justify-between mb-1.5">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.9)]"></span>
