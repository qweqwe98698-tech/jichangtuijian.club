  <!-- Interactive Realtime Animation Engine for Signal Atlas Observatory -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      initSignalAtlasEngine();
    });

    // Also run immediately if DOM is already ready
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initSignalAtlasEngine();
    }

    function initSignalAtlasEngine() {
      // Tab Switching Logic
      const tabTelemetry = document.getElementById('tab-telemetry');
      const tabTopology = document.getElementById('tab-topology');
      const tabSecurity = document.getElementById('tab-security');

      const viewTelemetry = document.getElementById('view-telemetry');
      const viewTopology = document.getElementById('view-topology');
      const viewSecurity = document.getElementById('view-security');

      function setActiveTab(activeBtn, activeView) {
        [tabTelemetry, tabTopology, tabSecurity].forEach((btn) => {
          if (btn) {
            btn.className = 'px-2.5 py-1 rounded-md bg-slate-900/60 text-slate-400 hover:text-slate-200 border border-white/5 transition-all';
          }
        });
        [viewTelemetry, viewTopology, viewSecurity].forEach((view) => {
          if (view) view.classList.add('hidden');
        });

        if (activeBtn) {
          activeBtn.className = 'px-2.5 py-1 rounded-md bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-semibold transition-all shadow-[0_0_12px_rgba(6,182,212,0.25)]';
        }
        if (activeView) {
          activeView.classList.remove('hidden');
        }
      }

      if (tabTelemetry) tabTelemetry.addEventListener('click', () => setActiveTab(tabTelemetry, viewTelemetry));
      if (tabTopology) tabTopology.addEventListener('click', () => setActiveTab(tabTopology, viewTopology));
      if (tabSecurity) tabSecurity.addEventListener('click', () => setActiveTab(tabSecurity, viewSecurity));

      // 1. Live Clock
      const clockEl = document.getElementById('console-live-clock');
      function updateClock() {
        const now = new Date();
        const h = String(now.getHours()).padStart(2, '0');
        const m = String(now.getMinutes()).padStart(2, '0');
        const s = String(now.getSeconds()).padStart(2, '0');
        if (clockEl) clockEl.textContent = `${h}:${m}:${s} CST`;
      }
      setInterval(updateClock, 1000);
      updateClock();

      // 2. High-Frequency Live Packet Stream Counter
      let packetCount = 24891;
      const packetEl = document.getElementById('live-packet-counter');
      setInterval(() => {
        packetCount += Math.floor(Math.random() * 6) + 3;
        if (packetEl) packetEl.textContent = `PKTS: ${packetCount.toLocaleString()}`;
      }, 400);

      // 3. Dynamic BGP Node Probe Rotator (前四固定：光速云、星岛梦、飞猫云、U1S1)
      const probeList = [
        '光速云 #1 (12.4ms · 满血专线)',
        '星岛梦 #2 (16.2ms · 不限时流量)',
        '飞猫云 #3 (16.9ms · 7元月付起)',
        'U1S1 #4 (17.8ms · 纯专线0丢包)',
        '灵猫网络 #5 (18.2ms · 大流量)',
        '速界 #6 (19.1ms · AI专属通道)',
        '宇宙云 #7 (15.5ms · 15元性价比)',
        'SOGO云 #8 (19.4ms · 4K秒开)',
        '唯兔云 #9 (18.7ms · 60+节点)',
        '一翻云 #10 (17.3ms · 150G)',
        '极连云 #11 (18.9ms · 专线)',
        '光年梯 #12 (19.6ms · 专线)',
      ];
      let probeIdx = 0;
      const rotatorEl = document.getElementById('live-probe-rotator');
      setInterval(() => {
        probeIdx = (probeIdx + 1) % probeList.length;
        if (rotatorEl) {
          rotatorEl.style.opacity = '0';
          setTimeout(() => {
            rotatorEl.textContent = probeList[probeIdx];
            rotatorEl.style.opacity = '1';
          }, 200);
        }
      }, 2200);

      // 4. Realtime I/O Bandwidth Rates
      const ioTrafficEl = document.getElementById('live-io-traffic');
      setInterval(() => {
        if (ioTrafficEl) {
          const tx = (13.5 + Math.random() * 3.8).toFixed(1);
          const rx = (92.4 + Math.random() * 18.5).toFixed(1);
          ioTrafficEl.textContent = `Tx: ${tx}M · Rx: ${rx}M`;
        }
      }, 1400);

      // 5. Latency & Jitter Micro-Fluctuations Engine
      const szLatencyEl = document.getElementById('live-latency-sz');
      const shLatencyEl = document.getElementById('live-latency-sh');
      const szJitterEl = document.getElementById('live-jitter-sz');
      const shJitterEl = document.getElementById('live-jitter-sh');
      const throughputEl = document.getElementById('live-throughput-val');
      const throughputBar = document.getElementById('live-throughput-bar');
      const peakValEl = document.getElementById('live-peak-val');
      const jitterDisplayEl = document.getElementById('live-jitter-display');

      setInterval(() => {
        // 深港 IEPL Latency
        if (szLatencyEl) {
          const sz = (12.1 + Math.random() * 0.6).toFixed(1);
          szLatencyEl.textContent = `${sz} ms`;
        }
        // 深港 Jitter
        if (szJitterEl) {
          const jSz = (0.7 + Math.random() * 0.3).toFixed(1);
          szJitterEl.textContent = `${jSz}ms`;
          if (jitterDisplayEl) {
            jitterDisplayEl.textContent = `Jitter: ${jSz}ms · 0.00% Loss`;
          }
        }
        // 沪日 IPLC Latency
        if (shLatencyEl) {
          const sh = (27.8 + Math.random() * 0.7).toFixed(1);
          shLatencyEl.textContent = `${sh} ms`;
        }
        // 沪日 Jitter
        if (shJitterEl) {
          const jSh = (1.0 + Math.random() * 0.3).toFixed(1);
          shJitterEl.textContent = `${jSh}ms`;
        }
        // 4K Throughput & Bar
        if (throughputEl && throughputBar) {
          const tp = (820 + Math.random() * 55).toFixed(1);
          throughputEl.textContent = `${tp} Mbps`;
          const pct = Math.min(96, Math.max(76, Math.round((tp / 1000) * 100)));
          throughputBar.style.width = `${pct}%`;
        }
        // Peak Bandwidth
        if (peakValEl) {
          const peak = (930 + Math.floor(Math.random() * 30));
          peakValEl.textContent = `${peak} Mbps`;
        }
      }, 1600);

      // 6. High-Performance Live Oscilloscope Canvas (ECG Waveform)
      const canvas = document.getElementById('oscilloscope-canvas');
      if (canvas) {
        const ctx = canvas.getContext('2d');
        let step = 0;

        function renderWave() {
          const parentWidth = canvas.parentElement ? canvas.parentElement.clientWidth : 380;
          const parentHeight = canvas.parentElement ? canvas.parentElement.clientHeight : 56;
          const dpr = window.devicePixelRatio || 1;

          if (canvas.width !== parentWidth * dpr || canvas.height !== parentHeight * dpr) {
            canvas.width = parentWidth * dpr;
            canvas.height = parentHeight * dpr;
            ctx.scale(dpr, dpr);
          }

          const width = parentWidth;
          const height = parentHeight;

          ctx.clearRect(0, 0, width, height);

          // Subtle Grid Background
          ctx.strokeStyle = 'rgba(6, 182, 212, 0.08)';
          ctx.lineWidth = 1;
          ctx.beginPath();
          // Horizontal mid line
          ctx.moveTo(0, height / 2);
          ctx.lineTo(width, height / 2);
          // Vertical grid bars
          const gridGap = 35;
          for (let gx = 0; gx < width; gx += gridGap) {
            ctx.moveTo(gx, 0);
            ctx.lineTo(gx, height);
          }
          ctx.stroke();

          // Active Telemetry Signal Waveform
          ctx.beginPath();
          ctx.strokeStyle = '#06b6d4'; // Glowing Cyan
          ctx.lineWidth = 2;
          ctx.shadowColor = '#06b6d4';
          ctx.shadowBlur = 8;

          const segments = 80;
          let leadPoint = { x: 0, y: height / 2 };

          for (let i = 0; i <= segments; i++) {
            const x = (i / segments) * width;
            // High-frequency telemetry network sine synthesis
            const baseSin = Math.sin((i * 0.22) + step * 0.09) * (height * 0.24);
            const harmonic = Math.cos((i * 0.45) - step * 0.05) * (height * 0.12);
            // Simulated heartbeat packet spikes
            const spike = Math.sin((i * 0.8) + step * 0.15) > 0.8 ? Math.sin((i * 0.8) + step * 0.15) * 8 : 0;
            const y = (height / 2) + baseSin + harmonic + spike;

            if (i === 0) {
              ctx.moveTo(x, y);
            } else {
              ctx.lineTo(x, y);
            }
            if (i === segments) {
              leadPoint = { x, y };
            }
          }
          ctx.stroke();

          // Fill underneath wave with glowing gradient
          ctx.shadowBlur = 0;
          ctx.lineTo(width, height);
          ctx.lineTo(0, height);
          ctx.closePath();
          const grad = ctx.createLinearGradient(0, 0, 0, height);
          grad.addColorStop(0, 'rgba(6, 182, 212, 0.25)');
          grad.addColorStop(1, 'rgba(6, 182, 212, 0.0)');
          ctx.fillStyle = grad;
          ctx.fill();

          // Draw Glowing Leading Signal Pulse Head
          ctx.beginPath();
          ctx.arc(leadPoint.x - 2, leadPoint.y, 3, 0, Math.PI * 2);
          ctx.fillStyle = '#10b981'; // Emerald Glowing Head
          ctx.shadowColor = '#10b981';
          ctx.shadowBlur = 10;
          ctx.fill();

          step++;
          requestAnimationFrame(renderWave);
        }

        requestAnimationFrame(renderWave);
      }
    }
  </script>
</BaseLayout>
