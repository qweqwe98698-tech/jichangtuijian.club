---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import ProviderCard from '../components/ProviderCard.astro';
import FAQ from '../components/FAQ.astro';
import NextStep from '../components/NextStep.astro';
import { getAllProviders } from '../lib/providers';

// Strict curation: Top 4 iOS Shadowrocket optimized providers (battery friendly & one-click QR sub)
const rocketProviders = getAllProviders().filter((p) =>
  ['guangsu', 'sujie', 'ermao', 'xingdaomeng'].includes(p.slug)
);

const faqs = [
  {
    question: 'Shadowrocket（小火箭）在国区 App Store 为什么搜索不到？',
    answer: '由于大陆地区政策原因，Shadowrocket 已从中国大陆区 App Store 下架。您需要准备一个美区或港区 Apple ID，在对应外区商店以 2.99 美元购买下载；或者直接使用本站【免费 Apple ID 共享池】中已购小火箭的公共账号登录下载。',
  },
  {
    question: '为什么 iPhone 开启小火箭后电池耗电速度明显加快？',
    answer: '手机端功耗主要取决于代理协议的加解密计算开销与保活机制。Shadowsocks-2022 与原生 Trojan 协议在 iOS 上直接调用苹果硬件加密指令集（AES-NI），CPU 负荷最低；若使用复杂的双重混淆或频繁握手的劣质节点，iPhone 后台功耗会成倍增加。推荐在小火箭中优选专线 SS 节点。',
  },
  {
    question: '在小火箭中如何设置分流才能让微信/支付宝完全走本地网络？',
    answer: '在 Shadowrocket 主界面正下方的【全局路由】中，务必选择【配置（Config）】模式，切勿选择【代理（Proxy）】模式。配合内置的“默认规则”或导入 ACL4SSR 规则文件，国内所有 APP、银行客户端与日常网站将 100% 走本地直连，不耗费代理流量且速度最快。',
  },
];
---

<BaseLayout
  title="2026 Shadowrocket 小火箭机场推荐：苹果 iOS 专用极速节点与省电选型"
  description="2026 苹果 iPhone / iPad Shadowrocket（小火箭）专用机场推荐。精选低功耗专线节点，支持扫码一键导入、自动更新订阅与分流规则，随时随地极速畅连海外网络。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumb items={[{ title: '小火箭机场推荐' }]} />

    <div class="max-w-3xl mb-8">
      <span class="text-xs font-mono font-bold text-blue-400 uppercase tracking-widest block mb-2">IOS SHADOWROCKET SPEC</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        2026 Shadowrocket 小火箭稳定机场推荐
      </h1>
      <p class="text-slate-300 text-sm sm:text-base mt-2">
        专为苹果 iOS 用户精选。手机端功耗极低、扫码秒导入，支持原生 5G 与 Wi-Fi 智能漫游切换。
      </p>
    </div>

    <QuickAnswer
      answerType="decision"
      summary="iOS 移动端强烈建议首选【光速云】（老牌 IEPL 专线，完整提供 Shadowsocks/VLESS 混合一键扫码，新人专属优惠码 AMM 享 8 折）与【速界】。小火箭导入后开启“配置（Rule）”分流模式，微信/淘宝走本地直连，推特/YouTube 走专线秒开，全天常驻后台续航无忧。"
      points={[
        '支持二维码扫描与一键唤起 Shadowrocket 订阅导入',
        '针对 iPhone 芯片硬件优化的低电量消耗与后台保活协议',
        '内置主流流媒体与 AI 工具分流策略组，无感分流',
      ]}
    />

    <!-- Curated Top Picks Grid -->
    <div class="my-10 space-y-6">
      <h2 class="text-xl font-bold text-white mb-4">🏆 2026 iOS 小火箭评测精选服务商</h2>
      {rocketProviders.map((p, idx) => (
        <ProviderCard provider={p} rankingIndex={idx} highlightBadge="iOS 深度优化认证" />
      ))}
    </div>

    <!-- 1000+ Word Deep Technical Article on iOS Tuning -->
    <article class="prose-atlas my-12 space-y-8">
      <section>
        <h2>一、iPhone 环境下各代理协议功耗与性能深度对比</h2>
        <p>
          在移动设备电池容量有限的场景下，代理协议的选择直接决定了全天续航体验：
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-4">
          <div class="p-4 rounded-xl bg-slate-900/70 border border-white/5 space-y-2">
            <h3 class="text-sm font-bold text-emerald-400 mb-1">Shadowsocks 协议 (最省电)</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              基于 AEAD 的轻量对称加密，直接由 iPhone Bionic 芯片硬件加速执行。常驻后台耗电量接近系统原生 VPN，是全天候开启的首选。
            </p>
          </div>
          <div class="p-4 rounded-xl bg-slate-900/70 border border-white/5 space-y-2">
            <h3 class="text-sm font-bold text-cyan-400 mb-1">VLESS-Reality (抗封锁最强)</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              完美复用大型海外站点（如 Apple、Microsoft）的真实 TLS 握手特征。在移动 5G 基站高频丢包网络下具备极强的抗审查能力。
            </p>
          </div>
          <div class="p-4 rounded-xl bg-slate-900/70 border border-white/5 space-y-2">
            <h3 class="text-sm font-bold text-amber-400 mb-1">Trojan / Hysteria 2 (大流量高吞吐)</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Trojan 流量完全融入标准 HTTPS 端口（443）；Hysteria 2 基于 UDP 暴力发包，适合在信号较差的弱网环境下强行挽救吞吐。
            </p>
          </div>
        </div>
      </section>

      <section>
        <h2>二、小火箭移动端进阶省电与分流技巧</h2>
        <ul class="space-y-2 text-sm text-slate-300 pl-5 list-disc">
          <li><strong>开启按需连接（On Demand）</strong>：在小火箭设置中启用“按需连接”，当锁屏或无数据交互时断开连接，息屏 0 耗电；</li>
          <li><strong>设置订阅自动更新</strong>：将订阅更新周期设置为 24 小时，避免高频请求机场 API 导致电量浪费；</li>
          <li><strong>启用 GEOIP 本地数据库</strong>：在分流规则中使用本地 Country.mmdb 数据库进行快速 IP 归属地判断，降低 DNS 查询开销。</li>
        </ul>
      </section>
    </article>

    <FAQ items={faqs} title="Shadowrocket 选型与使用问答" />

    <NextStep
      level="level2"
      title="需要小火箭下载与配置教程？"
      description="查看我们准备的小火箭美区 Apple ID 注册与 3 步扫码导入图文教程。"
      primaryLink={{ text: '查看 Shadowrocket 小火箭配置教程', url: '/tutorial/shadowrocket/' }}
      secondaryLink={{ text: '查看免费美区 Apple ID 共享池', url: '/apple-id/' }}
    />
  </div>
</BaseLayout>
