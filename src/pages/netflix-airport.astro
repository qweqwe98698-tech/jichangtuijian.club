---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import ProviderCard from '../components/ProviderCard.astro';
import FAQ from '../components/FAQ.astro';
import NextStep from '../components/NextStep.astro';
import { getAllProviders } from '../lib/providers';

const netflixProviders = getAllProviders().filter((p) => p.streamingSupport.netflix.includes('解锁') || p.streamingSupport.netflix.includes('全'));

const faqs = [
  {
    question: '为什么我的 Netflix 只能看到自制剧（如《怪奇物语》），搜不到非自制剧？',
    answer: '这说明你所连接的节点 IP 被 Netflix 识别为数据中心机房 IP（被判定为代理），Netflix 会屏蔽非自制版权内容。需要切换到支持“原生家庭宽带住宅 IP”或经过 DNS 解锁的特定节点。',
  },
];
---

<BaseLayout
  title="2026 Netflix 机场推荐：网飞全区非自制剧原生解锁与 4K HDR 专线"
  description="2026 Netflix 专用机场推荐。针对网飞最严格的住宅 IP 封锁与地区限制，精选美区、日区、港区、韩区全量非自制剧原生解锁节点。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumb items={[{ title: 'Netflix 机场推荐' }]} />

    <div class="max-w-3xl mb-8">
      <span class="text-xs font-mono font-bold text-rose-400 uppercase tracking-widest block mb-2">NETFLIX UNLOCK</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        2026 Netflix 网飞全区原生解锁机场推荐
      </h1>
      <p class="text-slate-300 text-sm sm:text-base mt-2">
        不再受限于自制剧。为影迷挑选真正支持全区非自制内容（如吉卜力动画、热门院线大片）的优质专线。
      </p>
    </div>

    <QuickAnswer
      answerType="decision"
      summary="Netflix 观影首推【光速云】（老牌 IEPL 专线，美日港台全区解锁非自制剧，专属优惠码 AMM 享 8 折）与【星岛梦】（支持 0 月租不限时按量计费）。实测美区、日区、新加坡区、中国台湾区 100% 识别为原生住宅宽带，支持 4K HDR 与杜比视界高码率传输。"
      points={[
        '支持 Netflix 最新风控算法下的持续解锁与动态 IP 补齐',
        '晚高峰 4K 码率稳定在 25Mbps 以上，0 缓冲圈',
        '完美支持 Apple TV、Google TV 电视端直接播放',
      ]}
    />

    <div class="my-10 space-y-6">
      {netflixProviders.map((p, idx) => (
        <ProviderCard provider={p} rankingIndex={idx} highlightBadge="Netflix 全区解锁" />
      ))}
    </div>

    <FAQ items={faqs} title="Netflix 解锁常见问题" />

    <NextStep
      level="level2"
      title="想了解 Netflix 账号注册与跨区片库差异？"
      description="查看 Netflix 各地区片库分布、非自制剧解锁原理与电视端配置全景指南。"
      primaryLink={{ text: '查看 Netflix 全区解锁与 4K 影音指南', url: '/netflix/' }}
      secondaryLink={{ text: '查看 4K 流媒体综合推荐', url: '/streaming-airport/' }}
    />
  </div>
</BaseLayout>
